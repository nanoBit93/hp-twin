# Kopie nach .env (gitignored) und Werte eintragen. .env wird NICHT committet.
HA_BASE_URL=http://homeassistant.local:8123
HA_TOKEN=

# Analyse-/Dev-API der laufenden hp-twin-Instanz (Home Assistant Add-on).
# URL = der Add-on-Host mit dem freigegebenen API-Port (Default 8000, siehe DOCS.md),
# Token = Add-on-Option "api_token" (leer dort -> kein Token nötig).
HP_TWIN_API_URL=
HP_TWIN_API_TOKEN=
